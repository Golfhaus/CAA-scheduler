{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coastal-american.example/schemas/canonical_schedule.schema.json",
  "title": "Coastal American Airways canonical schedule",
  "type": "object",
  "required": ["schemaVersion", "schedule", "provenance", "gatePlan", "operatingPolicy", "cities", "legs"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "version", "label", "status", "fleetCounts", "connectionWindowMinutes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "number": { "type": "integer", "minimum": 1 },
        "version": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "in_progress", "final"] },
        "fleetCounts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "connectionWindowMinutes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": { "type": "integer", "minimum": 0 },
            "maximum": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cityInformation", "operatingPolicy"],
      "oneOf": [
        { "required": ["workbook"], "not": { "required": ["construction"] } },
        { "required": ["construction"], "not": { "required": ["workbook"] } }
      ],
      "properties": {
        "workbook": { "$ref": "#/$defs/workbookSource" },
        "construction": { "$ref": "#/$defs/constructionSource" },
        "cityInformation": { "$ref": "#/$defs/fileSource" },
        "gateTimingBaseline": { "$ref": "#/$defs/fileSource" },
        "operatingPolicy": { "$ref": "#/$defs/fileSource" }
      }
    },
    "gatePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "forcedStandSplits"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "forcedStandSplits": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "operatingPolicy": { "$ref": "#/$defs/operatingPolicy" },
    "hubBanks": {
      "type": "array",
      "items": { "$ref": "#/$defs/hubBank" }
    },
    "bankAssignments": {
      "type": "array",
      "items": { "$ref": "#/$defs/bankAssignment" }
    },
    "cities": {
      "type": "array",
      "items": { "$ref": "#/$defs/city" }
    },
    "legs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/leg" }
    }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "nullableInteger": { "type": ["integer", "null"] },
    "nullableNumber": { "type": ["number", "null"] },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "time": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
    "fileSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256"],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "workbookSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "sheet"],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sheet": { "type": "string", "minLength": 1 }
      }
    },
    "identifiedFileSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "filename", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "filename": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "constructionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKind", "sourceScheduleId", "buildConfig", "demandData",
        "planningRules", "exactMaterialization"
      ],
      "properties": {
        "sourceKind": { "const": "deterministic_planner" },
        "sourceScheduleId": { "type": "string", "minLength": 1 },
        "buildConfig": { "$ref": "#/$defs/fileSource" },
        "demandData": { "$ref": "#/$defs/identifiedFileSource" },
        "planningRules": { "$ref": "#/$defs/identifiedFileSource" },
        "exactMaterialization": { "$ref": "#/$defs/fileSource" }
      }
    },
    "operatingPolicy": {
      "type": "object",
      "required": [
        "id", "source", "hubs", "focusCities",
        "departureWindows", "turns", "section26", "pointToPointMaximumShare",
        "marketMaximumDailyDeparturesPerDirection", "runwayScreeningFeet",
        "ronTargetCities", "destinationRonExemptions", "rollingRonWindowDays",
        "rollingRonGraceDays", "hubBankCounts", "hubBankWindowMinutes", "overrides"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "hubs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "focusCities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "departureWindows": { "type": "object" },
        "turns": { "type": "object" },
        "section26": { "type": "object" },
        "pointToPointMaximumShare": { "type": "number", "minimum": 0, "maximum": 1 },
        "marketMaximumDailyDeparturesPerDirection": { "type": "integer", "minimum": 1 },
        "runwayScreeningFeet": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "ronTargetCities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "destinationRonExemptions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "rollingRonWindowDays": { "type": "integer", "minimum": 1 },
        "rollingRonGraceDays": { "type": "integer", "minimum": 0 },
        "hubBankCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "hubBankWindowMinutes": { "type": "integer", "minimum": 1 },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["checkId", "findingId", "reason"],
            "properties": {
              "checkId": { "type": "string", "minLength": 1 },
              "findingId": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "approvedBy": { "type": "string" },
              "expiresAfterSchedule": { "type": ["integer", "null"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "hubBank": {
      "type": "object",
      "required": ["id", "hub", "startMinute", "endMinute"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "hub": { "type": "string", "minLength": 3 },
        "startMinute": { "type": "number", "minimum": 0, "exclusiveMaximum": 1440 },
        "endMinute": { "type": "number", "minimum": 0, "exclusiveMaximum": 1440 }
      },
      "additionalProperties": false
    },
    "bankAssignment": {
      "type": "object",
      "required": ["legId", "operation", "bankId"],
      "properties": {
        "legId": { "type": "string", "minLength": 1 },
        "operation": { "enum": ["arrival", "departure"] },
        "bankId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "city": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code", "name", "displayName", "sourceOrder", "group", "role", "active", "timezone",
        "hubAssignments", "maintenanceBase", "gateAllocationOverride",
        "standAllocationOverride", "latitude", "longitude",
        "runwayLengthFeet", "elevationFeet"
      ],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9]{3,4}$" },
        "name": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "sourceOrder": { "type": "integer", "minimum": 0 },
        "group": { "$ref": "#/$defs/nullableString" },
        "role": { "enum": ["hub", "focus_city", "destination", "unknown"] },
        "active": { "type": "boolean" },
        "timezone": { "$ref": "#/$defs/nullableString" },
        "hubAssignments": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z0-9]{3,4}$" },
          "uniqueItems": true
        },
        "maintenanceBase": { "type": "boolean" },
        "gateAllocationOverride": { "$ref": "#/$defs/nullableInteger" },
        "standAllocationOverride": { "$ref": "#/$defs/nullableInteger" },
        "latitude": { "$ref": "#/$defs/nullableNumber" },
        "longitude": { "$ref": "#/$defs/nullableNumber" },
        "runwayLengthFeet": { "$ref": "#/$defs/nullableInteger" },
        "elevationFeet": { "$ref": "#/$defs/nullableInteger" },
        "demandPercentile": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "leg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "route", "line", "fleet", "day", "sequenceWithinRoute",
        "pairing", "flight", "origin", "destination", "departure", "arrival",
        "departureMinute", "arrivalMinute"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "route": { "type": "integer", "minimum": 1 },
        "line": { "type": "string", "minLength": 1 },
        "fleet": { "type": "string", "minLength": 1 },
        "day": { "type": "integer", "minimum": 1 },
        "sequenceWithinRoute": { "type": "integer", "minimum": 1 },
        "pairing": { "type": "integer", "minimum": 1 },
        "flight": { "type": "integer", "minimum": 1 },
        "origin": { "type": "string", "pattern": "^[A-Z0-9]{3,4}$" },
        "destination": { "type": "string", "pattern": "^[A-Z0-9]{3,4}$" },
        "departure": { "$ref": "#/$defs/time" },
        "arrival": { "$ref": "#/$defs/time" },
        "departureMinute": { "type": "number", "minimum": 0, "exclusiveMaximum": 1440 },
        "arrivalMinute": { "type": "number", "minimum": 0, "exclusiveMaximum": 2880 }
      }
    }
  },
  "additionalProperties": false
}
