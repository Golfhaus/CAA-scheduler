{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coastal-american.example/schemas/canonical_schedule.schema.json",
  "title": "Coastal American Airways canonical schedule",
  "type": "object",
  "required": ["schemaVersion", "schedule", "provenance", "cities", "legs"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "version", "label", "status", "connectionWindowMinutes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "number": { "type": "integer", "minimum": 1 },
        "version": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "in_progress", "final"] },
        "connectionWindowMinutes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": { "type": "integer", "minimum": 0 },
            "maximum": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workbook", "cityInformation"],
      "properties": {
        "workbook": { "$ref": "#/$defs/workbookSource" },
        "cityInformation": { "$ref": "#/$defs/fileSource" }
      }
    },
    "cities": {
      "type": "array",
      "items": { "$ref": "#/$defs/city" }
    },
    "legs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/leg" }
    }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "nullableInteger": { "type": ["integer", "null"] },
    "nullableNumber": { "type": ["number", "null"] },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "time": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
    "fileSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256"],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "workbookSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "sheet"],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sheet": { "type": "string", "minLength": 1 }
      }
    },
    "city": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code", "name", "group", "role", "active", "timezone",
        "hubAssignments", "maintenanceBase", "gateAllocationOverride",
        "standAllocationOverride", "latitude", "longitude",
        "runwayLengthFeet", "elevationFeet"
      ],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9]{3,4}$" },
        "name": { "type": "string", "minLength": 1 },
        "group": { "$ref": "#/$defs/nullableString" },
        "role": { "enum": ["hub", "focus_city", "destination", "unknown"] },
        "active": { "type": "boolean" },
        "timezone": { "$ref": "#/$defs/nullableString" },
        "hubAssignments": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z0-9]{3,4}$" },
          "uniqueItems": true
        },
        "maintenanceBase": { "type": "boolean" },
        "gateAllocationOverride": { "$ref": "#/$defs/nullableInteger" },
        "standAllocationOverride": { "$ref": "#/$defs/nullableInteger" },
        "latitude": { "$ref": "#/$defs/nullableNumber" },
        "longitude": { "$ref": "#/$defs/nullableNumber" },
        "runwayLengthFeet": { "$ref": "#/$defs/nullableInteger" },
        "elevationFeet": { "$ref": "#/$defs/nullableInteger" }
      }
    },
    "leg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "route", "line", "fleet", "day", "sequenceWithinRoute",
        "pairing", "flight", "origin", "destination", "departure", "arrival"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "route": { "type": "integer", "minimum": 1 },
        "line": { "type": "string", "minLength": 1 },
        "fleet": { "type": "string", "minLength": 1 },
        "day": { "type": "integer", "minimum": 1 },
        "sequenceWithinRoute": { "type": "integer", "minimum": 1 },
        "pairing": { "type": "integer", "minimum": 1 },
        "flight": { "type": "integer", "minimum": 1 },
        "origin": { "type": "string", "pattern": "^[A-Z0-9]{3,4}$" },
        "destination": { "type": "string", "pattern": "^[A-Z0-9]{3,4}$" },
        "departure": { "$ref": "#/$defs/time" },
        "arrival": { "$ref": "#/$defs/time" }
      }
    }
  },
  "additionalProperties": false
}
