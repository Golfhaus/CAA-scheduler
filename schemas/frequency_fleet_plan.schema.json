{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coastal-american.example/schemas/frequency_fleet_plan.schema.json",
  "title": "Coastal American Airways frequency and fleet plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scheduleId",
    "sourceKind",
    "demandDataVersion",
    "planningRulesId",
    "status",
    "summary",
    "checks",
    "fleetPlan",
    "markets",
    "cityService",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "scheduleId": { "type": "string", "minLength": 1 },
    "sourceKind": { "const": "fresh_demand_allocation" },
    "demandDataVersion": { "type": "string", "minLength": 1 },
    "planningRulesId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pass", "fail"] },
    "summary": { "type": "object" },
    "checks": { "type": "array" },
    "fleetPlan": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "aircraftCount",
          "availableAircraftMinutes",
          "plannedAircraftMinutes",
          "remainingAircraftMinutes",
          "utilization",
          "marketCount",
          "roundTrips",
          "legCount"
        ]
      }
    },
    "markets": { "type": "array" },
    "cityService": { "type": "array" },
    "networkReconciliation": {
      "type": "object",
      "required": [
        "mode",
        "cityDecisions",
        "removedHistoricalServiceMarkets"
      ],
      "properties": {
        "mode": {
          "enum": ["preserve_historical_markets", "strict_tier_caps"]
        },
        "focusCitySubstitution": { "type": ["object", "null"] },
        "cityDecisions": { "type": "array" },
        "removedHistoricalServiceMarkets": { "type": "array" }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
