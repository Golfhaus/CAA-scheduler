{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coastal-american.example/schemas/build_config.schema.json",
  "title": "Coastal American Airways schedule build configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "buildId",
    "schedule",
    "startingPoint",
    "fleetCounts",
    "connectionWindowMinutes",
    "inputs",
    "networkChanges",
    "notes"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "buildId": { "type": "string", "pattern": "^schedule_[1-9][0-9]*_v[a-z0-9_]+$" },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "version", "label", "mode", "status"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "version": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["mainline", "skunkworks"] },
        "status": { "const": "draft" }
      }
    },
    "startingPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "scheduleId"],
      "properties": {
        "kind": { "enum": ["previous_schedule", "blank"] },
        "scheduleId": { "type": ["string", "null"] }
      }
    },
    "fleetCounts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Z0-9][A-Z0-9_-]*$" },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "connectionWindowMinutes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "type": "integer", "minimum": 0 },
        "maximum": { "type": "integer", "minimum": 1 }
      }
    },
    "constructionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixedPhysicalInventory", "optimizeNetworkAndUtilization"],
      "properties": {
        "fixedPhysicalInventory": { "type": "boolean" },
        "optimizeNetworkAndUtilization": { "type": "boolean" }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions", "cityInformation", "operatingPolicy", "demandData"],
      "properties": {
        "instructions": { "$ref": "#/$defs/versionedSource" },
        "cityInformation": { "$ref": "#/$defs/fileSource" },
        "operatingPolicy": { "$ref": "#/$defs/fileSource" },
        "demandData": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": { "version": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "networkChanges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["airport", "action", "targetStatus", "notes"],
        "properties": {
          "airport": { "type": "string", "pattern": "^[A-Z0-9]{3,4}$" },
          "action": { "enum": ["add", "remove", "status_change"] },
          "targetStatus": { "enum": ["", "destination", "focus_city", "hub", "inactive"] },
          "notes": { "type": "string" }
        }
      }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fileSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256"],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "versionedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
