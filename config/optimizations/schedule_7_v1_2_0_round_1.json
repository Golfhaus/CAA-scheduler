  "initiative": {
    "kind": "crj900_line_rebalance",
    "approvedBy": "user",
    "principles": [
      "Reclose the 28 existing CRJ900 aircraft-days as three 9\u201312-day lines before demand-ranked fleet promotion.",
      "Preserve all existing flights, markets, fleet inventory, gates, stands, banks, and operating overrides.",
      "Exchange seven same-station route suffixes and retime only SFB-ABE ten minutes later for a legal turn.",
      "Renumber CRJ900 routes sequentially within each new line; retain flight IDs and numbers.",
      "Keep all v1.2 work unpublished until explicitly authorized."
